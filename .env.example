# Copy to .env.local and fill in. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key from supabase dashboard or CLI>
# Server-only. Fetch via: supabase projects api-keys --project-ref <ref>
SUPABASE_SERVICE_ROLE_KEY=<service role key>
# Credentials the seed script creates and the e2e test signs in with
SEED_USER_EMAIL=you@example.com
SEED_USER_PASSWORD=<pick one>

# Google OAuth (Phase 3 calendar sync, Phase 7 Gmail). Create an OAuth client
# in Google Cloud Console with redirect URI
# http://localhost:3000/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Shared secret so the scheduler (edge function / pg_cron) can invoke
# POST /api/automations/run for every workspace. Any long random string.
AUTOMATION_RUN_SECRET=

# MCP server sign-in (falls back to SEED_USER_* when unset). All MCP calls
# run under this user's RLS.
MCP_USER_EMAIL=
MCP_USER_PASSWORD=
